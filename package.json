{
	"name": "skywatch",
	"devDependencies": {
		"next": "^16.1.5",
		"turbo": "^2.7.3"
	},
	"packageManager": "bun@1.2.14",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"build:web": "turbo run build --filter=@skywatch/web --only",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"run:web": "turbo run start --filter=@skywatch/web --only",
		"run:gateway": "turbo run start --filter=@skywatch/gateway --only"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
