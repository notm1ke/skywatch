{
	"compilerOptions": {
		"strict": true,
		"composite": true,
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"paths": {
			"@/*": ["./src/*"],
			"@/prisma/*": ["./prisma/*"],
			"@/workflows/*": ["./workflows/*"],
		},
		"plugins": [
			{
				"name": "workflow"
			}
		]
	}
}
